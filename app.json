{
  "expo": {
    "name": "Flight Board",
    "slug": "flight-board",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flightboard",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f3f2f2",
    "ios": {
      "bundleIdentifier": "com.flightboardgolf.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.flightboardgolf.app",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f2f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Flight Board uses your contacts so you can add playing partners without typing their names and numbers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b202756b-b3ba-4ecf-ad18-507b669c7c05"
      }
    },
    "owner": "mullinsdan72s-team"
  }
}
